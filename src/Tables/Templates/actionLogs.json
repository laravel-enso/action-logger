{
    "name": "Action Logs",
    "routePrefix": "system.actionLogs",
    "crtNo": true,
    "defaultSort": "action_logs.created_at",
    "defaultSortDirection": "desc",
    "buttons": [
        "excel"
    ],
    "columns": [
        {
            "label": "User",
            "name": "user",
            "data": "user",
            "resource": "LaravelEnso\\Users\\Http\\Resources\\User",
            "meta": [
                "slot",
                "notExportable"
            ]
        },
        {
            "label": "Method",
            "name": "method",
            "data": "action_logs.method",
            "enum": "LaravelEnso\\ActionLogger\\Enums\\Methods",
            "meta": [
                "slot",
                "sortable"
            ]
        },
        {
            "label": "Permission",
            "name": "permission",
            "data": "permission",
            "resource": "LaravelEnso\\Permissions\\Http\\Resources\\Permission",
            "meta": [
                "slot",
                "notExportable"
            ]
        },
        {
            "label": "URL",
            "name": "url",
            "data": "action_logs.url",
            "meta": [
                "searchable",
                "sortable"
            ]
        },
        {
            "label": "Duration",
            "name": "duration",
            "data": "action_logs.duration",
            "number": {
                "precision": 3
            },
            "meta": [
                "sortable"
            ]
        },
        {
            "label": "Created at",
            "name": "created_at",
            "data": "action_logs.created_at",
            "meta": [
                "datetime",
                "sortable"
            ]
        }
    ]
}
